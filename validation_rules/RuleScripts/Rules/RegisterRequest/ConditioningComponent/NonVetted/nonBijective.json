{
	"vsfScript": [
		{
			"lineType": "Rule",
			"ruleType": "External",
			"parameters": {
				"ruleText": "currentProperty.HOut >= 0.0"
			}
		},
		{
			"lineType": "Rule",
			"ruleType": "External",
			"parameters": {
				"ruleText": "currentProperty.HOut < currentProperty.NOut"
			}
		},
		{
			"lineType": "Rule",
			"ruleType": "External",
			"parameters": {
				"ruleText": "currentProperty.HOut < currentProperty.MinHIn"
			}
		},
		{
			"lineType": "Rule",
			"ruleType": "External",
			"parameters": {
				"ruleText": "currentProperty.HOut < currentProperty.MinNIn"
			}
		},
		{
			"lineType": "Rule",
			"ruleType": "External",
			"parameters": {
				"ruleText": "currentProperty.MinNIn >= currentProperty.Nw"
			}
		},
		{
			"lineType": "Rule",
			"ruleType": "External",
			"parameters": {
				"ruleText": "currentProperty.Nw >= currentProperty.NOut"
			}
		},
		{
			"lineType": "Rule",
			"ruleType": "External",
			"parameters": {
				"ruleText": "currentProperty.MinNIn >= currentProperty.NOut"
			}
		}
	]

}
