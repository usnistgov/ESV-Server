{
	"vsfScript": [
		{
			"lineType": "Rule",
			"ruleType": "External",
			"description": "This is one of the approved random bit generator constructions.",
			"references": ["SP 800-90B Section 2.2"],
			"parameters": {
				"ruleText": "currentProperty != RandomBitGeneratorConstructionType.Unknown"
			}
		},
		{
			"lineType": "Branch",
			"conditions": [
				{
					"if": {
						"scriptLines": [
							{
								"lineType": "Rule",
								"ruleType": "External",
								"parameters": {
									"ruleText": "currentProperty == RandomBitGeneratorConstructionType.RBG1"
								}
							}
						]
					},
					"then": {
						"scriptLines": [
							{
								"lineType": "Rule",
								"ruleType": "External",
								"description": "An RBG1 shall not use an entropy source directly",
								"references": ["SP 800-90C Table 1", "SP 800-90C Section 2.2", "SP 800-90C Section 4"],
								"parameters": {
									"ruleText": "rootProperty.Rbgs[rootRbgItemIndex].EntropySources == null"
								}
							}
						]
					}
				}
			]
		},
		{
			"lineType": "Branch",
			"conditions": [
				{
					"if": {
						"scriptLines": [
							{
								"lineType": "Rule",
								"ruleType": "External",
								"parameters": {
									"ruleText": "currentProperty != RandomBitGeneratorConstructionType.RBG1 && currentProperty != RandomBitGeneratorConstructionType.RBGC"
								}
							}
						]
					},
					"then": {
						"scriptLines": [
							{
								"lineType": "Rule",
								"ruleType": "External",
								"description": "An RBG2 or RBG3 shall use an entropy source directly",
								"references": ["SP 800-90C Table 1", "SP 800-90C Section 2.2"],
								"parameters": {
									"ruleText": "rootProperty.Rbgs[rootRbgItemIndex].EntropySources != null"
								}
							}
						]
					}
				}
			]
		},
		{
			"lineType": "Branch",
			"conditions": [
				{
					"if": {
						"scriptLines": [
							{
								"lineType": "Rule",
								"ruleType": "External",
								"parameters": {
									"ruleText": "currentProperty == RandomBitGeneratorConstructionType.RBG2P"
								}
							}
						]
					},
					"then": {
						"scriptLines": [
							{
								"lineType": "Rule",
								"ruleType": "External",
								"description": "RBG2 shall use an entropy source",
								"references": ["SP 800-90C Table 1"],
								"parameters": {
									"ruleText": "rootProperty.Rbgs[rootRbgItemIndex].EntropySources != null"
								}
							},
							{
								"lineType": "Assert",
								"description": "EntropyCertificateList is not null",
								"parameters": {
									"ruleText": "EntropyCertificateList != null"
								}
							},
							{
								"lineType": "Rule",
								"ruleType": "External",
								"description": "RBG2(P) shall use at least one physical entropy source",
								"references": ["SP 800-90C Table 1", "SP 800-90C Section 2.2", "SP 800-90C Section 5.1", "SP 800-90C Section 5.3 Requirement 9"],
								"parameters": {
									"ruleText": "EntropyCertificateList.Any(e => As(e, \"EntropyCertificate\").IsPhysical)"
								}
							}
						]
					}
				}
			]
		},
		{
			"lineType": "Branch",
			"conditions": [
				{
					"if": {
						"scriptLines": [
							{
								"lineType": "Rule",
								"ruleType": "External",
								"parameters": {
									"ruleText": "currentProperty == RandomBitGeneratorConstructionType.RBG2NP"
								}
							}
						]
					},
					"then": {
						"scriptLines": [
							{
								"lineType": "Rule",
								"ruleType": "External",
								"description": "RBG2 shall use an entropy source",
								"references": ["SP 800-90C Table 1"],
								"parameters": {
									"ruleText": "rootProperty.Rbgs[rootRbgItemIndex].EntropySources != null"
								}
							},
							{
								"lineType": "Assert",
								"description": "EntropyCertificateList is not null",
								"parameters": {
									"ruleText": "EntropyCertificateList != null"
								}
							},
							{
								"lineType": "Rule",
								"ruleType": "External",
								"description": "RBG2(NP) shall use at least one non-physical entropy source",
								"references": ["SP 800-90C Table 1", "SP 800-90C Section 2.2", "SP 800-90C Section 5.1", "SP 800-90C Section 5.3 Requirement 10"],
								"parameters": {
									"ruleText": "EntropyCertificateList.Any(e => !As(e, \"EntropyCertificate\").IsPhysical)"
								}
							}
						]
					}
				}
			]
		},
		{
			"lineType": "Branch",
			"conditions": [
				{
					"if": {
						"scriptLines": [
							{
								"lineType": "Rule",
								"ruleType": "External",
								"parameters": {
									"ruleText": "currentProperty == RandomBitGeneratorConstructionType.RBG3RS || currentProperty == RandomBitGeneratorConstructionType.RBG3XOR"
								}
							}
						]
					},
					"then": {
						"scriptLines": [
							{
								"lineType": "Rule",
								"ruleType": "External",
								"description": "RBG3 shall use at least one physical entropy source",
								"references": ["SP 800-90C Table 1", "SP 800-90C Section 2.2", "SP 800-90C Section 6.1", "SP 800-90C Section 6.3 Requirement 1"],
								"parameters": {
									"ruleText": "EntropyCertificateList.Any(e => As(e, \"EntropyCertificate\").IsPhysical)"
								}
							}
						]
					}
				}
			]
		},
		{
			"lineType": "Branch",
			"conditions": [
				{
					"if": {
						"scriptLines": [
							{
								"lineType": "Rule",
								"ruleType": "External",
								"parameters": {
									"ruleText": "currentProperty == RandomBitGeneratorConstructionType.RBGC"
								}
							},
							{
								"lineType": "Rule",
								"ruleType": "External",
								"parameters": {
									"ruleText": "rootProperty.Rbgs[rootRbgItemIndex].EntropySources != null"
								}
							}
						]
					},
					"then": {
						"scriptLines": [
							{
								"lineType": "Rule",
								"ruleType": "External",
								"description": "RBGC shall use a full entropy source if seeded by an entropy source",
								"references": ["SP 800-90C Table 1", "SP 800-90C Section 7.3.2 Requirements 4-5"],
								"parameters": {
									"ruleText": "EntropyCertificateList.Any(e => As(e, \"EntropyCertificate\").OperatingEnvironmentProperties.Any(oe => As(oe, \"EntropyCertificateOperatingEnvironmentProperties\").FullEntropy)) || FullEntropyConditioningFunction == true"
								}
							}
						]
					}
				}
			]
		}
	]
}